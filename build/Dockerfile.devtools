ARG image_digest=sha256:f528891ab1aa484bf7233dbcc84f3c806c3e427571d75510a9d74bb5ec535b33
 FROM debian:bookworm-slim@${image_digest}

# snphost is used for checking SNP machine availability and download vcek
# certs.
RUN apt-get update && apt-get install -y perl build-essential curl python3 python3-pip gcc libssl-dev pkg-config
ENV PATH="/root/.cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
RUN cargo install --version 0.5.0 snphost
RUN ln -s /root/.cargo/bin/snphost /usr/local/bin/snphost

RUN cargo install --version 0.6.2 sevctl
RUN pip3 install --break-system-packages sev-snp-measure

COPY ./generate_stage0_measurement.sh /generate_stage0_measurement.sh
# trusted_application_client_main is used for testing.
COPY ./output/trusted_application_client_main /trusted_application_client_main
